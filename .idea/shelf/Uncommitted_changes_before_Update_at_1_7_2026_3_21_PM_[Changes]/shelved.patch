                   description varchar(255)\r\n);\r\n\r\nCREATE TABLE role (\r\n                      role_id bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\r\n                      name varchar(255) UNIQUE NOT NULL,\r\n                      description varchar(255)\r\n);\r\n\r\nCREATE TABLE invalidated_token (\r\n                                   id varchar(255) PRIMARY KEY,\r\n                                   expiry_time timestamp(6)\r\n);\r\n\r\n-- 2. Tạo các bảng Account (Sử dụng UUID - varchar(255))\r\nCREATE TABLE member (\r\n                        member_id varchar(255) PRIMARY KEY,\r\n                        username varchar(255) UNIQUE NOT NULL,\r\n                        password varchar(255) NOT NULL,\r\n                        email varchar(255) UNIQUE NOT NULL,\r\n                        phone_number varchar(255) UNIQUE NOT NULL,\r\n                        first_name varchar(255),\r\n                        last_name varchar(255),\r\n                        dob date,\r\n                        day_created timestamp(6) NOT NULL,\r\n                        status varchar(255) NOT NULL,\r\n                        CONSTRAINT member_status_check CHECK (status IN ('ACTIVE', 'INACTIVE'))\r\n);\r\n\r\nCREATE TABLE employee_account (\r\n                                  employee_account_id varchar(255) PRIMARY KEY,\r\n                                  username varchar(255) UNIQUE NOT NULL,\r\n                                  password varchar(255) NOT NULL,\r\n                                  email varchar(255) UNIQUE,\r\n                                  employee_id bigint UNIQUE NOT NULL,\r\n                                  day_created timestamp(6) NOT NULL,\r\n                                  status varchar(255) NOT NULL,\r\n                                  CONSTRAINT employee_account_status_check CHECK (status IN ('ACTIVE', 'INACTIVE')),\r\n                                  CONSTRAINT fk_employee FOREIGN KEY (employee_id) REFERENCES employee(employee_id)\r\n);\r\n\r\n-- 3. Tạo các bảng quan hệ trung gian (Roles & Permissions)\r\nCREATE TABLE role_permissions (\r\n                                  role_role_id bigint NOT NULL,\r\n                                  permissions_permission_id bigint NOT NULL,\r\n                                  PRIMARY KEY (role_role_id, permissions_permission_id),\r\n                                  CONSTRAINT fk_role_permissions_role FOREIGN KEY (role_role_id) REFERENCES role(role_id),\r\n                                  CONSTRAINT fk_role_permissions_perm FOREIGN KEY (permissions_permission_id) REFERENCES permission(permission_id)\r\n);\r\n\r\nCREATE TABLE member_roles (\r\n                              member_member_id varchar(255) NOT NULL,\r\n                              roles_role_id bigint NOT NULL,\r\n                              PRIMARY KEY (member_member_id, roles_role_id),\r\n                              CONSTRAINT fk_member_roles_member FOREIGN KEY (member_member_id) REFERENCES member(member_id),\r\n                              CONSTRAINT fk_member_roles_role FOREIGN KEY (roles_role_id) REFERENCES role(role_id)\r\n);\r\n\r\nCREATE TABLE employee_account_roles (\r\n                                        employee_account_employee_account_id varchar(255) NOT NULL,\r\n                                        roles_role_id bigint NOT NULL,\r\n                                        PRIMARY KEY (employee_account_employee_account_id, roles_role_id),\r\n                                        CONSTRAINT fk_emp_roles_acc FOREIGN KEY (employee_account_employee_account_id) REFERENCES employee_account(employee_account_id),\r\n                                        CONSTRAINT fk_emp_roles_role FOREIGN KEY (roles_role_id) REFERENCES role(role_id)\r\n);\r\n\r\n-- 4. Tạo các bảng nghiệp vụ rạp (Room, Seat, Showtime)\r\nCREATE TABLE room (\r\n                      room_id bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\r\n                      room_name varchar(255),\r\n                      cinema_id bigint NOT NULL,\r\n                      CONSTRAINT fk_room_cinema FOREIGN KEY (cinema_id) REFERENCES cinema(cinema_id)\r\n);\r\n\r\nCREATE TABLE seat (\r\n                      seat_id bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\r\n                      seat_number integer NOT NULL,\r\n                      seat_row char(1),\r\n                      seat_type varchar(255),\r\n                      room_id bigint NOT NULL,\r\n                      CONSTRAINT seat_seat_type_check CHECK (seat_type IN ('CLASSIC', 'VIP')),\r\n                      CONSTRAINT fk_seat_room FOREIGN KEY (room_id) REFERENCES room(room_id)\r\n);\r\n\r\nCREATE TABLE show_time (\r\n                           showtime_id bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\r\n                           start_time timestamp(6),\r\n                           movie_id bigint NOT NULL,\r\n                           room_id bigint NOT NULL,\r\n                           CONSTRAINT uk_showtime UNIQUE (start_time, room_id),\r\n                           CONSTRAINT fk_showtime_movie FOREIGN KEY (movie_id) REFERENCES movie(movie_id),\r\n                           CONSTRAINT fk_showtime_room FOREIGN KEY (room_id) REFERENCES room(room_id)\r\n);\r\n\r\n-- 5. Giá vé và Giao dịch (TicketPrice, Booking)\r\nCREATE TABLE ticket_price (\r\n                              id bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\r\n                              price double precision NOT NULL,\r\n                              seat_type varchar(255),\r\n                              cinema_id bigint NOT NULL,\r\n                              day_type varchar(255) NOT NULL, -- Liên kết theo String như yêu cầu [cite: 48, 180]\r\n                              CONSTRAINT ticket_price_seat_type_check CHECK (seat_type IN ('CLASSIC', 'VIP')),\r\n                              CONSTRAINT fk_price_cinema FOREIGN KEY (cinema_id) REFERENCES cinema(cinema_id),\r\n                        