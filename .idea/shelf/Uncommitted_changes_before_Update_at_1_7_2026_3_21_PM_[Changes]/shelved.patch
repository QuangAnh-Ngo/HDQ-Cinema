UE NOT NULL,\r\n                            member_id varchar(255) NOT NULL,\r\n                            CONSTRAINT fk_pay_booking FOREIGN KEY (booking_id) REFERENCES booking(booking_id),\r\n                            CONSTRAINT fk_pay_member FOREIGN KEY (member_id) REFERENCES member(member_id)\r\n);\r\n\r\nINSERT INTO role (name, description) VALUES ('ADMIN', 'All Permission');
