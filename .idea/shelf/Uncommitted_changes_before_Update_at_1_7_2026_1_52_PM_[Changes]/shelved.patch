<+>-- 1. Tạo các bảng không phụ thuộc (Parent Tables)\r\nCREATE TABLE cinema (\r\n                        cinema_id bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\r\n                        name varchar(255),\r\n                        address varchar(255),\r\n                        city varchar(255),\r\n                        district varchar(255)\r\n);\r\n\r\nCREATE TABLE movie (\r\n                       movie_id bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\r\n                       title varchar(255),\r\n                       director varchar(255),\r\n                       genre varchar(255),\r\n                       duration integer,\r\n                       limit_age integer,\r\n                       poster varchar(255),\r\n                       trailer_url varchar(255),\r\n                       description varchar(255),\r\n                       day_start date,\r\n                       day_end date\r\n);\r\n\r\nCREATE TABLE day_type (\r\n                          id bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\r\n                          day_type varchar(255) UNIQUE NOT NULL, -- Dùng để liên kết với ticket_price\r\n                          day_start date,\r\n                          day_end date\r\n);\r\n\r\nCREATE TABLE employee (\r\n                          employee_id bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\r\n                          first_name varchar(255),\r\n                          last_name varchar(255),\r\n                          email varchar(255) UNIQUE,\r\n                          phone varchar(255) UNIQUE,\r\n                          position varchar(255) NOT NULL,\r\n                          CONSTRAINT employee_position_check CHECK (position IN ('EMPLOYEE', 'MANAGER', 'ADMIN'))\r\n);\r\n\r\nCREATE TABLE permission (\r\n                            permission_id bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\r\n                            name varchar(255) UNIQUE NOT NULL,\r\n                            description varchar(255)\r\n);\r\n\r\nCREATE TABLE role (\r\n                      role_id bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\r\n                      name varchar(255) UNIQUE NOT NULL,\r\n                      description varchar(255)\r\n);\r\n\r\nCREATE TABLE invalidated_token (\r\n                                   id varchar(255) PRIMARY KEY,\r\n                                   expiry_time timestamp(6)\r\n);\r\n\r\n-- 2. Tạo các bảng Account (Sử dụng UUID - varchar(255))\r\nCREATE TABLE member (\r\n                        member_id varchar(255) PRIMARY KEY,\r\n                        username varchar(255) UNIQUE NOT NULL,\r\n                        password varchar(255) NOT NULL,\r\n                        email varchar(255) UNIQUE NOT NULL,\r\n                        phone_number varchar(255) UNIQUE NOT NULL,\r\n                        first_name varchar(255),\r\n                        last_name varchar(255),\r\n                        dob date,\r\n                        day_created timestamp(6) NOT NULL,\r\n                        status varchar(255) NOT NULL,\r\n                        CONSTRAINT member_status_check CHECK (status IN ('ACTIVE', 'INACTIVE'))\r\n);\r\n\r\nCREATE TABLE employee_account (\r\n                                  employee_account_id varchar(255) PRIMARY KEY,\r\n                                  username varchar(255) UNIQUE NOT NULL,\r\n                                  password varchar(255) NOT NULL,\r\n                                  email varchar(255) UNIQUE,\r\n                                  employee_id bigint UNIQUE NOT NULL,\r\n                                  day_created timestamp(6) NOT NULL,\r\n                                  status varchar(255) NOT NULL,\r\n                                  CONSTRAINT employee_account_status_check CHECK (status IN ('ACTIVE', 'INACTIVE')),\r\n                                  CONSTRAINT fk_employee FOREIGN KEY (employee_id) REFERENCES employee(employee_id)\r\n);\r\n\r\n-- 3. Tạo các bảng quan hệ trung gian (Roles & Permissions)\r\nCREATE TABLE role_permissions (\r\n                                  role_role_id bigint NOT NULL,\r\n                                  permissions_permission_id bigint NOT NULL,\r\n                                  PRIMARY KEY (role_role_id, permissions_permission_id),\r\n                                  CONSTRAINT fk_role_permissions_role FOREIGN KEY (role_role_id) REFERENCES role(role_id),\r\n                                  CONSTRAINT fk_role_permissions_perm FOREIGN KEY (permissions_permission_id) REFERENCES permission(permission_id)\r\n);\r\n\r\nCREATE TABLE member_roles (\r\n                              member_member_id varchar(255) NOT NULL,\r\n                              roles_role_id bigint NOT NULL,\r\n                              PRIMARY KEY (member_member_id, roles_role_id),\r\n                              CONSTRAINT fk_member_roles_member FOREIGN KEY (member_member_id) REFERENCES member(member_id),\r\n                              CONSTRAINT fk_member_roles_role FOREIGN KEY (roles_role_id) REFERENCES role(role_id)\r\n);\r\n\r\nCREATE TABLE employee_account_roles (\r\n                                        employee_account_employee_account_id varchar(255) NOT NULL,\r\n                                        roles_role_id bigint NOT NULL,\r\n                                        PRIMARY KEY (employee_account_employee_account_id, roles_role_id),\r\n                                        CONSTRAINT fk_emp_roles_acc FOREIGN KEY (employee_account_employee_account_id) REFERENCES employee_account(employee_account_id),\r\n                                        CONSTRAINT fk_emp_roles_role FOREIGN KEY (roles_role_id) REFERENCES role(role_id)\r\n);\r\n\r\n-- 4. Tạo các bảng nghiệp vụ rạp (Room, Seat, Showtime)\r\nCREATE TABLE room (\r\n                      room_id bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\r\n                      room_name varchar(255),\r\n                      cinema_id bigint NOT NULL,\r\n                      CONSTRAINT fk_room_cinema FOREIGN KEY (cinema_id) REFERENCES cinema(cinema_id)\r\n);\r\n\r\nCREATE TABLE seat (\r\n                      seat_id bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\r\n                      seat_number integer NOT NULL,\r\n                      seat_row char(1),\r\n                      seat_type varchar(255),\r\n                      room_id bigint NOT NULL,\r\n                      CONSTRAINT seat_seat_type_check CHECK (seat_type IN ('CLASSIC', 'VIP')),\r\n                      CONSTRAINT fk_seat_room FOREIGN KEY (room_id) REFERENCES room(room_id)\r\n);\r\n\r\nCREATE TABLE show_time (\r\n                           showtime_id bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\r\n                           start_time timestamp(6),\r\n                           movie_id bigint NOT NULL,\r\n                           room_id bigint NOT NULL,\r\n                           CONSTRAINT uk_showtime UNIQUE (start_time, room_id),\r\n                           CONSTRAINT fk_showtime_movie FOREIGN KEY (movie_id) REFERENCES movie(movie_id),\r\n                           CONSTRAINT fk_showtime_room FOREIGN KEY (room_id) REFERENCES room(room_id)\r\n);\r\n\r\n-- 5. Giá vé và Giao dịch (TicketPrice, Booking)\r\nCREATE TABLE ticket_price (\r\n                              id bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\r\n                              price double precision NOT NULL,\r\n                              seat_type varchar(255),\r\n                              cinema_id bigint NOT NULL,\r\n                              day_type varchar(255) NOT NULL, -- Liên kết theo String như yêu cầu [cite: 48, 180]\r\n                              CONSTRAINT ticket_price_seat_type_check CHECK (seat_type IN ('CLASSIC', 'VIP')),\r\n                              CONSTRAINT fk_price_cinema FOREIGN KEY (cinema_id) REFERENCES cinema(cinema_id),\r\n                              CONSTRAINT fk_price_daytype FOREIGN KEY (day_type) REFERENCES day_type(day_type)\r\n);\r\n\r\nCREATE TABLE booking (\r\n                         booking_id bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\r\n                         total_price double precision NOT NULL,\r\n                         create_time timestamp(6),\r\n                         booking_status varchar(255),\r\n                         member_id varchar(255) NOT NULL,\r\n                         CONSTRAINT booking_booking_status_check CHECK (booking_status IN ('PENDING', 'CONFIRM')),\r\n                         CONSTRAINT fk_booking_member FOREIGN KEY (member_id) REFERENCES member(member_id)\r\n);\r\n\r\nCREATE TABLE booking_detail (\r\n                                id bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\r\n                                price double precision NOT NULL,\r\n                                seat_status varchar(255),\r\n                                booking_id bigint NOT NULL,\r\n                                seat_id bigint NOT NULL,\r\n                                showtime_id bigint NOT NULL,\r\n                                CONSTRAINT booking_detail_seat_status_check CHECK (seat_status IN ('BOOKED', 'AVAILABLE', 'HELD')),\r\n                                CONSTRAINT uk_seat_showtime UNIQUE (seat_id, showtime_id),\r\n                                CONSTRAINT fk_detail_booking FOREIGN KEY (booking_id) REFERENCES booking(booking_id),\r\n                                CONSTRAINT fk_detail_seat FOREIGN KEY (seat_id) REFERENCES seat(seat_id),\r\n                                CONSTRAINT fk_detail_showtime FOREIGN KEY (showtime_id) REFERENCES show_time(showtime_id)\r\n);\r\n\r\nCREATE TABLE paymenturl (\r\n                            url varchar(2048) PRIMARY KEY,\r\n                            amount double precision NOT NULL,\r\n                            created_at timestamp(6) NOT NULL,\r\n                            booking_id bigint UNIQUE NOT NULL,\r\n                            member_id varchar(255) NOT NULL,\r\n                            CONSTRAINT fk_pay_booking FOREIGN KEY (booking_id) REFERENCES booking(booking_id),\r\n                            CONSTRAINT fk_pay_member FOREIGN KEY (member_id) REFERENCES member(member_id)\r\n);\r\n\r\nINSERT INTO role (name, description) VALUES ('ADMIN', 'All Permission');
